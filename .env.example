# Nexview - technische Einstellungen.
# WICHTIG: Hier stehen KEINE API-Keys von TMDB/Radarr/Sonarr!
# Die trägst du später in der App unter "Einstellungen" ein (Admin).

# Zufälliger, geheimer Schlüssel. Wird für Login-Tokens und zum Verschlüsseln
# der API-Keys in der Datenbank verwendet.
# Erzeugen mit:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Wenn leer, erzeugt Nexview beim ersten Start automatisch einen und legt ihn
# unter data/secret.key ab.
NEXVIEW_SECRET_KEY=

# Verzeichnis für Datenbank und Schlüsseldatei
NEXVIEW_DATA_DIR=./data

# Gültigkeit der Login-Tokens
NEXVIEW_ACCESS_TOKEN_MINUTES=30
NEXVIEW_REFRESH_TOKEN_DAYS=30

# Erlaubte Herkunft für den Browser im Entwicklungsmodus (Vite-Dev-Server).
# Im Docker-Container nicht nötig, da Frontend und Backend zusammen laufen.
NEXVIEW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ordner mit dem gebauten Frontend (wird im Docker-Container gesetzt)
NEXVIEW_STATIC_DIR=

# Notausgang fuer die Protokoll-Stufe. Normalerweise stellt man sie in der App
# unter Einstellungen > Protokoll ein - diese Variable ueberstimmt das und ist
# fuer den Fall gedacht, dass Nexview gar nicht erst startet.
# Erlaubt: quiet | normal | detailed | trace
NEXVIEW_LOG_LEVEL=

# Woher Nexview die Adresse des Anfragenden nimmt. Gebraucht von der
# Anmeldebremse: Nach zu vielen Fehlversuchen wird gebremst und danach fuer
# eine Viertelstunde gesperrt (sie geht von selbst wieder auf).
#
# Nach Konto wird immer gezaehlt - dafuer ist hier nichts noetig. Nach Adresse
# nur, wenn hier steht, wie Nexview an die echte Adresse kommt:
#
#   leer      nur nach Konto (Vorgabe, immer sicher)
#   direct    Nexview haengt direkt am Netz
#   proxy     genau ein Reverse Proxy davor
#   proxy:2   zwei davor, z. B. Cloudflare und dahinter ein eigener
#
# ⚠️ Im Zweifel leer lassen. Steht hier "direct", obwohl ein Proxy davorsteht,
# sehen alle Anfragen aus wie dieselbe Adresse - dann sperrt ein einziger
# Vertipper den ganzen Haushalt aus.
NEXVIEW_CLIENT_IP=

# Ob das Anmelde-Cookie nur ueber HTTPS mitgeschickt werden darf (Secure).
# Das Cookie haelt die Anmeldung; es ist HttpOnly und fuer Skripte im Browser
# unlesbar.
#
#   auto      Secure genau dann, wenn die Anfrage ueber https hereinkam
#             (Vorgabe - funktioniert ueberall, auch ohne HTTPS)
#   on        Secure immer erzwingen
#   off       Secure nie setzen
#
# Wann "on"? Wenn ein Reverse Proxy HTTPS abschliesst und intern schlichtes
# http an Nexview weiterreicht. Nexview sieht dann "http" und laesst Secure
# bei "auto" weg - das Cookie funktioniert zwar, ist aber nicht dagegen
# geschuetzt, versehentlich unverschluesselt zu wandern.
#
# ⚠️ Nicht auf "on" stellen, wenn Nexview ueber http:// erreichbar sein soll.
# Der Browser wirft ein Secure-Cookie ueber http weg - dann kommt niemand mehr
# hinein.
NEXVIEW_COOKIE_SECURE=auto

# Unterpfad hinter einem Reverse Proxy, z. B. /nexview fuer
# https://example.com/nexview/. Leer (Vorgabe) heisst: Nexview wohnt an der
# Wurzel, alles bleibt wie bisher.
#
# Nexview antwortet dann mit UND ohne Vorbau - beide ueblichen
# Proxy-Einstellungen (durchreichen wie abschneiden) funktionieren. Beispiele
# fuer nginx, Caddy, Traefik und Nginx Proxy Manager stehen in der README
# unter "Behind a reverse proxy".
#
# ⚠️ Die oeffentliche Adresse in den Einstellungen muss den Vorbau enthalten
# (https://example.com/nexview), sonst fuehren verschickte Links ins Leere.
NEXVIEW_URL_BASE=

# Die Inhaltsregeln der Seite (Content-Security-Policy). Sie sagen dem Browser,
# woher er laden und wohin er schicken darf; alles andere lehnt er ab.
#
#   on           Regeln gelten (Vorgabe)
#   report-only  Regeln werden nur gemeldet, nicht durchgesetzt - zum Nachsehen
#                in der Browser-Konsole, bevor man scharf schaltet
#   off          gar keine Kopfzeile
#
# ⚠️ Eine zu enge Regel zeigt keine Fehlermeldung, sondern eine halb geladene
# Seite. Deshalb gibt es diesen Schalter.
NEXVIEW_CSP=on

# Wer Nexview in einen Rahmen stecken darf.
#
#   none    niemand (Vorgabe)
#   self    nur Nexview selbst
#   <Adresse>  z. B. https://brett.zuhause.lan
#
# ⚠️ Wer Nexview in einem Uebersichts-Brett (Organizr o. Ae.) eingebettet hat,
# muss das hier setzen - sonst bleibt der Rahmen leer, ohne Fehlermeldung.
NEXVIEW_FRAME_ANCESTORS=none

# Zusaetzliche Bildquellen, mit Leerzeichen getrennt.
#
# Nur noetig, wenn im Kalender die Poster leer bleiben: Nexview reicht dort die
# Adressen durch, die Radarr/Sonarr gespeichert haben, und die haengen am
# Metadaten-Anbieter des Hauses. Die ueblichen (TMDB, TheTVDB, fanart.tv) sind
# schon erlaubt.
#
# Beispiel: NEXVIEW_IMG_SOURCES=https://bilder.example.org
NEXVIEW_IMG_SOURCES=

# Der Betreiber dieser Installation - ein Notausgang, sonst nichts.
#
# Normalerweise bleibt das hier leer: Das Konto aus dem Einrichtungsassistenten
# bekommt den Betreiber-Haken von selbst, und weitergeben kann ihn nur sein
# Traeger, im Profil.
#
# Gebraucht wird die Zeile nur, wenn der Betreiber sich aussperrt - Passwort
# weg und kein Mailversand eingerichtet, Anmeldedienst tot, Konto unbrauchbar.
# Dann den **Benutzernamen** eintragen, einmal neu starten, und die Zeile
# wieder herausnehmen.
#
# ⚠️ Sie wird bei **jedem** Start gelesen. Bleibt sie stehen, ist der Betreiber
# dauerhaft von aussen festgelegt, und die Uebergabe in der Oberflaeche wird
# ausdruecklich verweigert - statt beim naechsten Neustart still
# zurueckzuspringen. Ein Name, den es nicht gibt, wird mit einer Warnung im
# Protokoll ignoriert; ein Konto entsteht daraus nicht.
NEXVIEW_BETREIBER=
