# Dateien, die im Linux-Container ausgefuehrt werden, brauchen zwingend
# Unix-Zeilenenden - auch wenn sie unter Windows bearbeitet werden.
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Git-Haken laufen unter Windows ueber Git Bash. Mit CRLF scheitert schon die
# erste Zeile ("bad interpreter"), und der Haken faellt still aus - genau der
# Haken, der Personendaten aufhalten soll. Er hat keine .sh-Endung, die Regel
# oben greift also nicht.
.githooks/* text eol=lf
