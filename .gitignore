# --- Geheimnisse und Daten: dürfen NIEMALS ins öffentliche Repo ---
.env
.env.*
!.env.example
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# Messdatei der Abdeckungspruefung - entsteht bei jedem Lauf neu.
.coverage
htmlcov/
.mypy_cache/
*.egg-info/

# --- Node / Frontend ---
node_modules/
dist/
# Behelfsbau zum Ansehen, wenn der Vite-Build lokal nicht laufen kann.
dist-dev/
.vite/
*.local

# --- Editoren / Betriebssystem ---
.vscode/
.idea/
# Werkzeug-Verzeichnis, kein Projektbestandteil. Die Startdatei darin traegt
# Pfade dieses einen Rechners (unter Windows .venv/Scripts, sonst .venv/bin) -
# eingecheckt waere sie fuer jeden anderen eine Vorlage, die nicht startet.
.claude/
.DS_Store
Thumbs.db

# Sicherungskopien des Datenverzeichnisses (enthalten secret.key!)
data-sicherung*/

# Zwischenstand der TypeScript-Pruefung - reines Bauartefakt.
*.tsbuildinfo
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
# Zeigt auf ein privates Claude-Design-Projekt - nicht in einen
# oeffentlichen Repo.
.design-sync/projekt-kennung.txt

# Der Ende-zu-Ende-Test legt sich sein eigenes Datenverzeichnis an - eine
# leere Datenbank je Lauf, damit der Einrichtungsassistent ueberhaupt
# erscheint. Bericht und Bildschirmfotos entstehen nur bei Fehlschlaegen.
frontend/.e2e-data/
# Dasselbe fuer den Unterpfad-Aufbau (eigenes Backend samt Datenbank).
frontend/.e2e-data-unterpfad/
frontend/playwright-report/
frontend/test-results/
# ⚠️ Auch im Wurzelverzeichnis: Wird Playwright versehentlich von dort statt
# aus frontend/ gestartet, legt es seine Ausgabe hier ab - und die Regeln oben
# greifen dann nicht. Einmal war .last-run.json schon im Commit.
playwright-report/
test-results/
