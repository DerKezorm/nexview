# Nexview - technische Einstellungen.
# WICHTIG: Hier stehen KEINE API-Keys von TMDB/Radarr/Sonarr!
# Die trägst du später in der App unter "Einstellungen" ein (Admin).

# Zufälliger, geheimer Schlüssel. Wird für Login-Tokens und zum Verschlüsseln
# der API-Keys in der Datenbank verwendet.
# Erzeugen mit:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Wenn leer, erzeugt Nexview beim ersten Start automatisch einen und legt ihn
# unter data/secret.key ab.
NEXVIEW_SECRET_KEY=

# Verzeichnis für Datenbank und Schlüsseldatei
NEXVIEW_DATA_DIR=./data

# Gültigkeit der Login-Tokens
NEXVIEW_ACCESS_TOKEN_MINUTES=30
NEXVIEW_REFRESH_TOKEN_DAYS=30

# Erlaubte Herkunft für den Browser im Entwicklungsmodus (Vite-Dev-Server).
# Im Docker-Container nicht nötig, da Frontend und Backend zusammen laufen.
NEXVIEW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ordner mit dem gebauten Frontend (wird im Docker-Container gesetzt)
NEXVIEW_STATIC_DIR=
